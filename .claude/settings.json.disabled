{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": ".venv/bin/python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": ".venv/bin/python \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt_inject.py\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".venv/bin/python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_score.py\"", "async": true, "timeout": 120 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": ".venv/bin/python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_end_file.py\"", "async": true, "timeout": 600 }
        ]
      }
    ]
  }
}
